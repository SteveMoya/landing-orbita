---
import { site } from '../../data/site';
import Icon from '../ui/Icon.astro';
---

<div
  data-menu
  id="mobile-menu"
  class="fixed inset-0 z-40 hidden lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <div class="absolute inset-0 bg-void/95 backdrop-blur-xl"></div>

  <nav class="container-orbita relative flex h-full flex-col justify-center gap-2" aria-label="Menú móvil">
    {
      site.nav.map((item) => (
        <a
          href={item.href}
          class="py-2 font-display text-3xl font-bold tracking-tight text-stardust transition-colors duration-200 hover:text-ion"
        >
          {item.label}
        </a>
      ))
    }
    <a
      href={`mailto:${site.email}`}
      class="mt-8 inline-flex w-full items-center justify-center rounded-full bg-ion px-6 py-4 font-display text-sm font-bold uppercase tracking-[0.15em] text-void"
    >
      Reservar misión
    </a>
    <div class="mt-10 flex gap-4">
      {
        site.socials.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.name}
            class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-stardust/20 text-stardust transition-all duration-200 hover:-translate-y-0.5 hover:border-ion/60 hover:text-ion"
          >
            <Icon name={s.icon} size={18} />
          </a>
        ))
      }
    </div>
  </nav>

  <button
    data-menu-close
    type="button"
    class="absolute right-5 top-5 inline-flex h-10 w-10 items-center justify-center rounded-full border border-stardust/20 text-stardust"
    aria-label="Cerrar menú"
  >
    <Icon name="close" size={22} />
  </button>
</div>
