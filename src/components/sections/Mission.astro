---
import { mission } from '../../data/mission';
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';

const toneText: Record<string, string> = {
  ion: 'text-ion',
  pulse: 'text-pulse',
  orbit: 'text-orbit',
  stardust: 'text-stardust',
};

const toneDot: Record<string, string> = {
  ion: 'bg-ion shadow-ion',
  pulse: 'bg-pulse shadow-pulse',
  orbit: 'bg-orbit shadow-[0_0_12px_rgb(245_158_11/0.6)]',
  stardust: 'bg-stardust shadow-[0_0_12px_rgb(232_234_255/0.6)]',
};
---

<Section id="mision" ariaLabelledBy="mission-title">
  <div class="mb-14 max-w-2xl">
    <p class="hud-label mb-3">Misión</p>
    <h2
      id="mission-title"
      class="font-display text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl"
    >
      Cómo llega una persona <span class="bg-gradient-to-r from-ion to-pulse bg-clip-text text-transparent">al espacio</span>
    </h2>
  </div>

  <ol class="relative grid gap-8 md:grid-cols-5 md:gap-5">
    <!-- línea conectora -->
    <div aria-hidden="true" class="absolute left-5 top-0 h-full w-px bg-gradient-to-b from-ion/60 via-pulse/40 to-transparent md:left-0 md:top-5 md:h-px md:w-full md:bg-gradient-to-r"></div>

    {
      mission.map((step, index) => (
        <li data-reveal style={`--reveal-delay:${index * 100}ms`} class="relative pl-14 md:pl-0 md:pt-14">
          <span class:list={['absolute left-0 top-0 grid h-10 w-10 place-items-center rounded-full border border-stardust/20 bg-void md:left-0 md:top-1', toneText[step.tone]]} aria-hidden="true">
            <span class:list={['h-2 w-2 rounded-full', toneDot[step.tone]]}></span>
          </span>
          <p class:list={['font-hud text-[11px] font-medium uppercase tracking-[0.2em]', toneText[step.tone]]}>{step.phase}</p>
          <h3 class="mt-1 font-display text-lg font-bold tracking-tight">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-stardust/60">{step.description}</p>
          <p class="mt-3 inline-flex items-center gap-1.5 font-hud text-[10px] uppercase tracking-[0.15em] text-stardust/45">
            <Icon name="rocket" size={11} class="text-ion" />
            {step.duration}
          </p>
        </li>
      ))
    }
  </ol>
</Section>
