---
import { site } from '../../data/site';
import Logo from '../brand/Logo.astro';
import Icon from '../ui/Icon.astro';
---

<footer class="border-t border-stardust/10 bg-void">
  <div class="container-orbita py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-5">
        <Logo />
        <p class="max-w-xs text-sm leading-relaxed text-stardust/55">
          {site.description}
        </p>
        <div class="flex gap-3">
          {
            site.socials.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.name}
                class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-stardust/15 text-stardust/70 transition-all duration-200 hover:-translate-y-0.5 hover:border-ion/60 hover:text-ion"
              >
                <Icon name={s.icon} size={17} />
              </a>
            ))
          }
        </div>
      </div>

      <nav aria-label="Explorar">
        <h3 class="hud-label mb-4">Explorar</h3>
        <ul class="space-y-3">
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-stardust/55 transition-colors hover:text-ion">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-4">
        <h3 class="hud-label">Contacto</h3>
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 text-sm text-stardust/55 transition-colors hover:text-ion"
        >
          <Icon name="mail" size={16} class="text-ion" />
          {site.email}
        </a>
        <p class="max-w-[220px] text-xs leading-relaxed text-stardust/40">
          Respuesta en menos de 24 horas, en cualquier zona horaria terrestre.
        </p>
      </div>

      <div>
        <h3 class="hud-label mb-4">¿Despegas pronto?</h3>
        <a
          href={`mailto:${site.email}?subject=Misi%C3%B3n%20nueva`}
          class="inline-flex items-center gap-2 rounded-full border border-ion/40 bg-ion/10 px-5 py-3 font-hud text-xs font-medium uppercase tracking-[0.15em] text-ion transition-all duration-200 hover:bg-ion hover:text-void"
        >
          Reservar misión
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-stardust/10 pt-8 text-xs text-stardust/40 sm:flex-row">
      <p>© {new Date().getFullYear()} {site.name}. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href={site.legal.privacy} class="transition-colors hover:text-ion">Aviso de privacidad</a>
        <a href={site.legal.terms} class="transition-colors hover:text-ion">Términos</a>
      </div>
    </div>
  </div>
</footer>
