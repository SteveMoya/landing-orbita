---
import { site } from '../../data/site';
import Logo from '../brand/Logo.astro';
import Navigation from './Navigation.astro';
import MobileMenu from './MobileMenu.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<header data-header class="fixed inset-x-0 top-0 z-50">
  <div class="container-orbita flex h-16 items-center justify-between md:h-20">
    <Logo />

    <Navigation class="hidden lg:flex" />

    <div class="flex items-center gap-3">
      <Button href={`mailto:${site.email}`} size="sm" class="hidden sm:inline-flex">
        Reservar misión
        <Icon name="arrow-right" size={14} />
      </Button>
      <button
        data-menu-button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-stardust/20 text-stardust transition-colors hover:border-ion/60 hover:text-ion lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <MobileMenu />
</header>

<script>
  import { initHeader } from '../../scripts/header';

  initHeader();
</script>
